%% Lineup data model: Firestore document model (Mermaid class diagram)
%% Source of truth: the "Data model" section of
%%   docs/superpowers/specs/2026-11-25-firestore-migration-design.md
%% and the implementation in api/internal/docstore
%% schedulePrefs shape: api/internal/prefs/prefs.go
%%
%% Conventions
%%   - One class per document or collection; fields are camelCase.
%%   - Class name carries the document path.
%%   - Composition (*--) marks subcollections or embedded data that cannot
%%     outlive the parent document; dashed arrows are ID references only.
%%   - Dates are YYYY-MM-DD strings; timestamps are Firestore timestamps.

classDiagram
    direction TB

    class User {
        <<users/{firebaseUid}>>
        +string email
        +string displayName
        +string region
        +map schedulePrefs
        +timestamp createdAt
        +timestamp updatedAt
    }

    class SchedulePrefs {
        <<value object>>
        +map~dow, Window~ windows
    }

    class Window {
        <<value object>>
        +bool enabled
        +string start
        +string end
    }

    class Entry {
        <<users/{uid}/entries/{titleId}>>
        +string titleId
        +string status
        +number rating
        +bool favorite
        +int pointerSeason
        +int pointerEpisode
        +timestamp addedAt
        +timestamp watchedAt
    }

    class Guide {
        <<users/{uid}/guides/{guideId}>>
        +string startDate
        +string endDate
        +number seed
        +timestamp createdAt
        +GuideItem[] items
    }

    class GuideItem {
        <<embedded array element>>
        +string id
        +string date
        +int startMin
        +int endMin
        +string titleId
        +int season
        +int episode
        +number providerId
        +bool isPlan
        +bool pinned
        +bool edited
        +bool watched
    }

    class Title {
        <<titles/{kind}-{tmdbId}>>
        +string kind
        +number tmdbId
        +number tvmazeId
        +string name
        +string overview
        +string posterPath
        +int runtimeMinutes
        +bool airing
        +timestamp refreshedAt
        +timestamp providersRefreshedAt
        +timestamp airingsRefreshedAt
        +map seasons
        +Airing[] airings
        +map providers
    }

    class Airing {
        <<embedded array element>>
        +int season
        +int episode
        +string airDate
    }

    class Provider {
        <<providers/{providerId}>>
        +string name
        +string logoPath
    }

    User "1" *-- "1" SchedulePrefs : schedulePrefs map
    SchedulePrefs "1" *-- "0..7" Window : per day-of-week
    User "1" *-- "0..*" Entry : entries subcollection
    User "1" *-- "0..*" Guide : guides subcollection
    Guide "1" *-- "0..*" GuideItem : items array
    Title "1" *-- "0..*" Airing : airings array

    Entry "0..*" ..> "1" Title : titleId
    GuideItem "0..*" ..> "1" Title : titleId
    GuideItem "0..*" ..> "1" Provider : providerId
    Title "0..*" ..> "0..*" Provider : providers map, region to provider IDs

    note for Title "kind: movie | series; ID is kind-tmdbId (series-1399)
seasons: season number (string key) -> episode count
providers: region -> sorted provider IDs
runtimeMinutes 0 = unknown; engine defaults 45 (series) / 120 (movie)"
    note for Entry "status: none | watchlist | rotation | watched
rating 0.5-5.0 in half steps, absent when unset; rotation cap 10 (API-enforced)"
    note for GuideItem "id: 10 random base62 chars, unique within its guide
startMin/endMin: minutes from local midnight
season=0, episode=0 = movie; isPlan=false = alternate row"
    note for Window "start/end: HH:MM 24h; end 23:59 = midnight sentinel
keyed by dow: mon..sun"
